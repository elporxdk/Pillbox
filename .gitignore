# --- Node / Vite ---
node_modules
dist
dist-ssr
*.local

# Estado local de `wrangler dev` (cache y almacenamiento simulado). Se regenera.
.wrangler/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Python (Medibot / Pi) ---
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
.venv/
venv/
env/

# Datos de runtime del Pillbox (estado local de la Pi)
pillbox_data.json

# Salida de Medibot en la maquina donde corre (no es codigo).
#  Anclados con barra inicial A PROPOSITO: `data/` a secas coincide con
#  CUALQUIER carpeta llamada data a cualquier profundidad, y se llevo por delante
#  src/data/, que si es codigo. El resultado fue un import a un fichero que no
#  estaba en el repo: compilaba en local y el build de Cloudflare moria.
/videos/
/data/
trainer.yml
trainer_labels.json

# Volcados de datos: no son codigo y no deben publicarse en el sitio
doctores.txt
*.dump
*.sqlite
*.sqlite3

# --- CREDENCIALES - nunca al repositorio ---
#  Un token de Cloudflare da permiso de Edit sobre el DNS y los tuneles: quien
#  lo tenga puede repuntar el dominio a donde quiera. Y un token publicado en
#  GitHub se queda en el historial de git aunque luego se borre el fichero.
#  Los ficheros de credenciales van FUERA del repo (~/.medibot/), pero estas
#  reglas estan aqui como red por si alguno acaba dentro por descuido.
.env
.env.*
!.env.example
#  Secrets del Worker para `wrangler dev`. Aqui va la clave de la API del
#  asistente cuando se prueba en local; en produccion es un secret de Cloudflare.
.dev.vars
.dev.vars.*
!.dev.vars.example
*.token
*_token.txt
cf_token*
cloudflared/
*.pem
credenciales*.json

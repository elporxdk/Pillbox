# Clave de la API de Anthropic (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=

# Modelo a usar. claude-haiku-4-5 es rapido y barato, ideal para chat por WhatsApp.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Ruta al ejecutable de Chromium/Chrome instalado en tu maquina.
# Dejar vacio para que Puppeteer use el Chromium que descarga solo.
# Ejemplos: /usr/bin/chromium  |  /usr/bin/google-chrome  |  C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
